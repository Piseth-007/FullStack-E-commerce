# Botaniq Frontend Environment Variables
# Duplicate this file as .env before starting the development server:
# cp .env.example .env

# Backend Laravel REST API Base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Google OAuth 2.0 Client ID (Web Application credentials from Google Cloud Console)
# Ensure your authorized JavaScript origin includes: http://localhost:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# API Backend Base URL (Use https://api.yourdomain.com/api for production, or http://127.0.0.1:8000/api for local development)
VITE_API_BASE_URL=https://api.yourdomain.com/api

# Google OAuth Client ID (Optional, matches Google Cloud Console Authorized JavaScript origins)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
